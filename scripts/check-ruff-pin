#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

CRATES_IO = "registry+https://github.com/rust-lang/crates.io-index"


def git(root: Path, *args: str) -> str:
    return subprocess.check_output(["git", "-C", root, *args], text=True).strip()


def check_corpus(root: Path) -> str:
    if Path(git(root, "rev-parse", "--show-toplevel")).resolve() != root:
        raise ValueError(f"{root} is not the root of its Git checkout")
    entries = git(root, "ls-files", "--stage", "--", "vendor/ruff").splitlines()
    if len(entries) != 1:
        raise ValueError("vendor/ruff is not recorded as a single Git submodule entry")
    mode, revision, stage, _ = entries[0].split()
    if mode != "160000" or stage != "0":
        raise ValueError("vendor/ruff is not recorded as a Git submodule")
    ruff = root / "vendor/ruff"
    if not (ruff / ".git").exists():
        raise ValueError(
            "Ruff submodule is not initialized; run 'git submodule update --init vendor/ruff'"
        )
    if Path(git(ruff, "rev-parse", "--show-toplevel")).resolve() != ruff:
        raise ValueError(f"{ruff} is not the root of the Ruff submodule checkout")
    if git(ruff, "rev-parse", "HEAD^{commit}") != revision:
        raise ValueError("Ruff submodule HEAD does not match its gitlink")
    if git(ruff, "status", "--porcelain=v1", "--untracked-files=all"):
        raise ValueError("Ruff submodule has local changes; restore the pinned corpus")
    return revision


def cargo_metadata(root: Path) -> dict:
    # Cargo checks the lockfile and downloads the checksum-verified registry sources.
    return json.loads(
        subprocess.check_output(
            ["cargo", "metadata", "--locked", "--format-version", "1"],
            cwd=root,
            text=True,
        )
    )


def check_dependencies(root: Path, revision: str) -> None:
    packages = [
        p for p in cargo_metadata(root)["packages"] if p["name"].startswith("ruff_")
    ]
    if not packages:
        raise ValueError("Cargo metadata has no Ruff dependencies")
    if len({package["version"] for package in packages}) != 1:
        raise ValueError("Ruff dependencies must resolve to one release")
    for package in packages:
        name = package["name"]
        if package.get("source") != CRATES_IO:
            raise ValueError(f"{name} must resolve to crates.io")
        source = Path(package["manifest_path"]).parent
        vcs = json.loads((source / ".cargo_vcs_info.json").read_text())["git"]
        if vcs.get("sha1") != revision or vcs.get("dirty", False):
            raise ValueError(
                f"{name} published source revision does not match Ruff corpus {revision}"
            )


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Check Ruff dependencies and corpus identity."
    )
    parser.add_argument(
        "--repo-root", type=Path, default=Path(__file__).resolve().parent.parent
    )
    root = parser.parse_args().repo_root.resolve()
    try:
        revision = check_corpus(root)
        check_dependencies(root, revision)
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    print(
        f"Ruff crates.io dependencies, lockfile, gitlink, and clean submodule agree on {revision}"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
