#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
python="${1:-${CPYTHON:-python3.14}}"
ruff="$repo_root/vendor/ruff"

"$repo_root/scripts/check-ruff-pin"

corpus_roots=(
    "$ruff/crates/ty_python_semantic/resources/corpus"
    "$ruff/crates/ruff_python_parser/resources/valid"
    "$ruff/crates/ruff_python_parser/resources/inline/ok"
    "$ruff/crates/ruff_linter/resources/test/fixtures"
    "$ruff/crates/ruff_python_formatter/resources/test/fixtures"
)

for corpus_root in "${corpus_roots[@]}"; do
    if [[ ! -d "$corpus_root" ]]; then
        echo "error: CPython compatibility corpus is missing: $corpus_root" >&2
        echo "Initialize it with: git -C '$repo_root' submodule update --init --depth 1 vendor/ruff" >&2
        exit 2
    fi
done

cargo run --locked --manifest-path "$repo_root/Cargo.toml" \
  -p serc --example compare_cpython_corpus -- \
  --python "$python" \
  --expected-files 2451 \
  --expected-exact 2230 \
  --expected-cpython-rejected 221 \
  --expected-outcome matched-rejection=151 \
  --expected-outcome rejection-mismatch=56 \
  --expected-outcome byte-mismatch=0 \
  --expected-outcome unsupported=0 \
  --expected-outcome parse-mismatch=0 \
  --expected-outcome compiler-failure=14 \
  --expected-outcome non-utf8=0 \
  --expected-outcome oracle-failure=0 \
  --require-all \
  "${corpus_roots[@]}"
