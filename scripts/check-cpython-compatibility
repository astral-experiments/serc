#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ $# -gt 2 ]]; then
    echo "usage: check-cpython-compatibility [PYTHON [3.12|3.13|3.14|3.15]]" >&2
    exit 2
fi

python_version="${2:-3.14}"
case "$python_version" in
    3.12)
        expected_exact=2174
        expected_rejected=277
        expected_matched_rejection=210
        expected_rejection_mismatch=61
        expected_compiler_failure=6
        ;;
    3.13)
        expected_exact=2193
        expected_rejected=258
        expected_matched_rejection=196
        expected_rejection_mismatch=55
        expected_compiler_failure=7
        ;;
    3.14)
        expected_exact=2230
        expected_rejected=221
        expected_matched_rejection=152
        expected_rejection_mismatch=55
        expected_compiler_failure=14
        ;;
    3.15)
        expected_exact=2249
        expected_rejected=202
        expected_matched_rejection=133
        expected_rejection_mismatch=55
        expected_compiler_failure=14
        ;;
    *)
        echo "error: unsupported Python target '$python_version'; expected 3.12, 3.13, 3.14, or 3.15" >&2
        exit 2
        ;;
esac
python="${1:-${CPYTHON:-python$python_version}}"
ruff="$repo_root/vendor/ruff"

"$repo_root/scripts/check-ruff-pin"

corpus_roots=(
    "$ruff/crates/ty_python_semantic/resources/corpus"
    "$ruff/crates/ruff_python_parser/resources/valid"
    "$ruff/crates/ruff_python_parser/resources/inline/ok"
    "$ruff/crates/ruff_linter/resources/test/fixtures"
    "$ruff/crates/ruff_python_formatter/resources/test/fixtures"
)

for corpus_root in "${corpus_roots[@]}"; do
    if [[ ! -d "$corpus_root" ]]; then
        echo "error: CPython compatibility corpus is missing: $corpus_root" >&2
        echo "Initialize it with: git -C '$repo_root' submodule update --init --depth 1 vendor/ruff" >&2
        exit 2
    fi
done

comparison_args=(
    --python "$python"
    --python-version "$python_version"
    --expected-files 2451
    --expected-exact "$expected_exact"
    --expected-cpython-rejected "$expected_rejected"
    --expected-outcome "matched-rejection=$expected_matched_rejection"
    --expected-outcome "rejection-mismatch=$expected_rejection_mismatch"
    --expected-outcome byte-mismatch=0
    --expected-outcome unsupported=0
    --expected-outcome parse-mismatch=0
    --expected-outcome "compiler-failure=$expected_compiler_failure"
    --expected-outcome non-utf8=0
    --expected-outcome oracle-failure=0
    --require-all
)
if [[ "$python_version" != 3.14 ]]; then
    comparison_args+=(--source-bytes)
fi

cargo run --locked --manifest-path "$repo_root/Cargo.toml" \
  -p serc --example compare_cpython_corpus -- \
  "${comparison_args[@]}" \
  "${corpus_roots[@]}"
